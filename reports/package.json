{
  "name": "reports",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:pull-env": "npm run env:pull && vite",
    "build": "vite build",
    "start": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test:e2e": "playwright test",
    "env:pull": "dotenv -e .env.bws.local -- tsx scripts/bws/pull-env.ts",
    "env:push": "dotenv -e .env.local -- tsx scripts/bws/push-env.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "clean-dev": "vite --force",
    "prepare": "husky",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.893.0",
    "@fontsource/montserrat": "^5.3.0",
