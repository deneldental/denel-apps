# Copy to scripts/neon-legacy-data-migration.env (gitignored) and fill in.
# Sourced by scripts/neon-legacy-data-migration.sh; plain KEY=value lines.

# Neon (dashboard → Connection Details). Required for `inspect` / `download`.
NEON_HOST=ep-xxxxxxxx-pooler.region.aws.neon.tech
NEON_PASSWORD=
# NEON_USER=neondb_owner
# NEON_DB=neondb

# VPS. Required for `push`. VPS_DB_PASSWORD is the postgres password from the
# Docker Compose environment at /opt/framada on the server.
VPS_HOST=root@<vps-ip-or-hostname>
VPS_DB_PASSWORD=
# VPS_SSH_KEY=$HOME/.ssh/id_hetzner_framada
# VPS_DB_CONTAINER=framada-db-1
# VPS_DB_USER=postgres
# VPS_DB_NAME=framadadb

# Local dev Postgres used by `verify` (documented default, not a secret).
# LOCAL_DEV_PASSWORD=framada
