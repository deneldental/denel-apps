{
  "name": "backend",
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "dev:wrangler": "wrangler dev",
    "build": "tsup",
    "start": "node dist/node.js",
    "deploy": "wrangler deploy --minify",
    "seed:rbac": "tsx src/scripts/seed-rbac.ts",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "seed:test-logins": "tsx src/scripts/seed-test-logins.ts",
    "seed:custom-finance": "tsx src/scripts/seed-custom-finance-role.ts",
    "audit:staff-phones": "tsx src/scripts/audit-staff-phones.ts",
    "db:local:up": "node scripts/db-local.mjs up",
    "db:local:down": "node scripts/db-local.mjs down",
    "db:local:reset": "node scripts/db-local.mjs reset && pnpm db:local:setup",
    "db:local:setup": "node scripts/dev-local.mjs node migrate.mjs && node scripts/dev-local.mjs tsx src/scripts/seed-rbac.ts && node scripts/dev-local.mjs tsx src/scripts/seed-admin.ts",
    "dev:local": "node scripts/dev-local.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "db:migrate": "node migrate.mjs",
    "db:generate": "drizzle-kit generate",
    "db:drift": "tsx src/scripts/schema-drift-check.ts",
    "money:units": "tsx src/scripts/money-unit-check.ts",
    "money:snapshot": "tsx src/scripts/money-cutover-check.ts snapshot",
    "money:verify": "tsx src/scripts/money-cutover-check.ts verify",
    "payment-methods:audit": "tsx src/scripts/payment-method-audit.ts",
    "audit:purge-secrets": "tsx src/scripts/purge-audit-secrets.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.893.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "@denel/rbac": "workspace:^",
    "@denel/types": "workspace:^",
    "@denel/utils": "workspace:^",
    "@hono/node-server": "^1.12.0",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.4.0",
    "@hono/zod-validator": "^0.9.0",
    "@neondatabase/serverless": "^1.0.2",
    "@node-rs/argon2": "^2.0.2",
    "@sentry/node": "^10.55.0",
    "@types/sanitize-html": "^2.16.1",
    "better-auth": "^1.4.19",
    "cloudinary": "^2.10.0",
    "cron-parser": "^5.5.0",
    "csv-parse": "^5.6.0",
    "date-fns": "^4.1.0",
    "dinero.js": "1.9.1",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.3",
    "libphonenumber-js": "^1.12.34",
    "node-cron": "^4.2.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.19.0",
    "pino": "^10.3.1",
    "puppeteer": "^24.10.0",
    "resend": "^6.9.2",
    "sanitize-html": "^2.17.4",
    "web-push": "^3.6.7",
    "ws": "^8",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/dinero.js": "^2.0.0",
    "@types/node": "^25.3.2",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.18.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8",
    "@upstash/qstash-cli": "^2.37.18",
    "@vitest/coverage-v8": "^4.0.18",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "wrangler": "^4.69.0"
  }
}
