node_modules/
.pnpm-store/
dist/
.next/
.nx/
.wrangler/
out/
build/
coverage/
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Windows reserved-name artifacts and local Claude worktrees
**/NUL
.claude/worktrees/

# Raw rebrand source files (brand guide PDF, original logo exports) — staging
# area only; processed assets get committed under packages/assets/ instead.
brand-assets-inbox/

# Environment files — never commit secrets
.env
# Filled-in copy of scripts/neon-legacy-data-migration.env.example
scripts/neon-legacy-data-migration.env
# CSV exports of patient/staff data made by scripts/neon-legacy-data-migration.sh
tmp-neon-migration/
# Source archives made by `pnpm run package:source` (scripts/package-source.mjs)
/tmp/
.env.local
.env.*.local
.env.development
.env.staging
.env.production
.dev.vars
.dev.vars.*
!.dev.vars.example

.vercel
*.tsbuildinfo

# Turborepo cache + per-package logs
.turbo/
**/.turbo/

# Playwright E2E artifacts — videos, traces, screenshots, HTML reports.
# These are regenerated on every run and must never be committed (a local run
# once swept ~174 .webm/.zip files into a commit because they weren't ignored).
test-results/
**/test-results/
playwright-report/
**/playwright-report/
**/.last-run.json

# graphify knowledge-graph output (generated; regenerate with /graphify . --update)
# Keep the human-readable report versioned; exclude the heavy regenerable state
# (graph.json, manifest.json, graph.html, cache/). Ignore contents, not the dir,
# so the report can be re-included (git can't un-ignore inside an ignored dir).
graphify-out/*
**/graphify-out/*
!graphify-out/GRAPH_REPORT.md

# Generated by scripts/generate-csv-templates.sh — regenerate on demand
csv-templates/

# Generated by scripts/neon-legacy-data-migration.sh `download` — contains real
# patient PII + financial data pulled from the legacy Neon snapshot. Never commit.
tmp-neon-migration/

# Personal Claude Code state — never commit (settings.local.json once held DB URLs)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# One-off patch scripts and stray copies at the repo root — never commit
scratch/

# Throwaway output dumps of the one-off parity scripts (money-parity.mjs,
# plan-parity-snapshot.mjs write them with `> file`); they hold per-patient balances
backend/scripts/plan-parity-*.txt
backend/scripts/sums.*.txt

# Metadata files a document tool leaves beside a report
*.md.metadata.json

# Claude Code: a personal permission allow-list is not project config. (The tracked one held
# only one-off grep/python/rm approvals with paths from the original author's machine.)
.claude/settings.json

# Local dev scratch / one-off diagnostic scripts — never commit
backend/scratch*.ts
backend/scratch*.js
backend/fix.js
backend/fix.mjs
backend/fix-constraint.js
backend/reset-pass.js
backend/test-auth*.ts
backend/_e2e_portal.mjs
backend/audit-module.mjs
backend/audit-patients.mjs
backend/backend-openapi.json
backend/check_db_raw.ts
portals/check-dest.ts

# Extra safety — private keys / certs, tool credential files, general logs, editor state
*.key
*.p12
*.pfx
*.pkcs12
id_rsa
id_ed25519
.sentryclirc
*.log
.idea/
*.swp

